# Copy to .env and adjust as needed.
# Used by docker compose and helper scripts.

# Default model for make targets (qwen3.5-0.8b, llama3.2-1b, gemma3-1b, gemma3-270m, gemma4-e2b)
MODEL=qwen3.5-0.8b

# Host ports per model (from models.yaml):
#   qwen3.5-0.8b  -> 8082
#   llama3.2-1b   -> 8079
#   gemma3-1b     -> 8081
#   gemma3-270m   -> 8083
#   gemma4-e2b    -> 8084

# Runtime overrides (optional)
# MODEL_PATH=/app/models/override.gguf
# THREADS=4

# query-api.sh defaults
# API_BASE_URL=http://localhost:8082
# PROMPT=Hello, who are you?

# docker-run.sh defaults
# IMAGE_NAME=hudzy/llamaedge:qwen3.5-0.8b
# PORT=8082
# CPUS=4.0
# MEMORY=6g
